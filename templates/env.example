# Copy to .env (never commit it). `kit` loads ./.env; real environment variables win.

# ---- which framework runs the agent
AGENT_FRAMEWORK=openai_agents          # openai_agents | langgraph | adk | strands

# ---- model (default: the offline scripted model, no keys needed)
MODEL_PROVIDER=scripted                # scripted | openai | openai_compatible | anthropic | bedrock | gemini
# MODEL_NAME=
# OPENAI_API_KEY=                      # openai (and openai_compatible unless MODEL_API_KEY_ENV names another var)
# ANTHROPIC_API_KEY=
# MODEL_BASE_URL=                      # openai_compatible: your gateway, e.g. https://gateway.internal/v1
# MODEL_API_KEY_ENV=                   # name of the env var holding the gateway key
# AWS_REGION=                          # bedrock (credentials from the standard AWS chain)
# GOOGLE_CLOUD_PROJECT=                # gemini on the Gemini Enterprise Agent Platform (credentials from ADC)
# GOOGLE_CLOUD_LOCATION=

# ---- order system (default: in-memory demo orders)
# ORDER_API_URL=http://127.0.0.1:8081  # the bundled mock (uvicorn mock_api.app:app --port 8081) or your API
# ORDER_API_TOKEN=

# ---- service
# KIT_AUTH=oidc                        # oidc | api_key | dev (dev also needs KIT_ENV=dev; `kit dev` sets both)
# KIT_OIDC_ISSUER=
# KIT_OIDC_AUDIENCE=
# KIT_API_KEYS=                        # api_key mode: comma-separated keys (from a secret manager)
# SESSION_STORE=sqlite:///.kit/sessions.db   # or postgresql+psycopg://user:pass@host/db
# REFUND_APPROVAL_LIMIT=5000
# PROMPT_STAGE=prod

# ---- telemetry (OpenTelemetry; needs agent-starter-kit[otel])
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=support-agent
# KIT_CAPTURE_CONTENT=false
